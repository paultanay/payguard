# PayGuard Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ─── PayPal Sandbox Credentials ──────────────────────────────────────────────
# Get these from https://developer.paypal.com/dashboard/applications/sandbox
# Leave empty to use the deterministic payment simulator (offline mode)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ─── Payment Simulator ───────────────────────────────────────────────────────
# Set to 'true' to force simulator even if PayPal credentials are set
USE_SIMULATOR=false

# ─── Signing Key ─────────────────────────────────────────────────────────────
# Ed25519 private key as 64-char hex string
# If not set, an ephemeral key is generated at startup (signatures don't survive restart)
# Generate: node -e "import('@noble/ed25519').then(e => console.log(Buffer.from(e.utils.randomPrivateKey()).toString('hex')))"
PAYGUARD_SIGNING_KEY=

# ─── AI Provider ─────────────────────────────────────────────────────────────
# Use OpenRouter's free model router without purchasing provider credits:
#   AI_PROVIDER=openrouter
#   OPENROUTER_API_KEY=your_openrouter_key
#   AI_MODEL=openrouter/free
# OpenRouter's free route can be rate-limited or temporarily unavailable.
# Direct OpenAI remains supported with OPENAI_API_KEY and AI_PROVIDER=openai.
# If only OPENROUTER_API_KEY is set, OpenRouter is selected automatically.
# If neither key is set, deterministic proposal extraction is used instead.
AI_PROVIDER=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
AI_MODEL=

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─── Database ────────────────────────────────────────────────────────────────
# Path to SQLite database file (relative to project root)
DB_PATH=./data/payguard.db
